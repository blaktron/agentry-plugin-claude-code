{
  "name": "agentry",
  "owner": {
    "name": "Agentry",
    "url": "https://secureagentry.net"
  },
  "metadata": {
    "description": "The Agentry plugin for Claude Code",
    "version": "0.1.0"
  },
  "plugins": [
    {
      "name": "agentry",
      "source": "./",
      "description": "Find, verify, install and run QuickAgents (signed, scanned agent packages with a declared capability contract) and build your own, from your agent host.",
      "version": "0.1.0",
      "author": {
        "name": "Agentry",
        "url": "https://secureagentry.net"
      },
      "homepage": "https://docs.secureagentry.net/agentry/mcp/",
      "repository": "https://github.com/blaktron/agentry-plugin-claude-code",
      "license": "MIT",
      "keywords": [
        "agentry",
        "quickagents",
        "agents",
        "mcp",
        "skills",
        "sandbox",
        "supply-chain",
        "security"
      ],
      "category": "development",
      "mcpServers": {
        "agentry": {
          "command": "node",
          "args": [
            "${CLAUDE_PLUGIN_ROOT}/server/agentry-mcp.mjs"
          ]
        }
      }
    }
  ]
}
